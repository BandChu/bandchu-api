{
  "dashboard": {
    "id": null,
    "uid": "bandchu-api",
    "title": "BandChu API Dashboard",
    "tags": ["bandchu", "spring-boot"],
    "timezone": "Asia/Seoul",
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{application=\"bandchu-api\"}[1m])",
            "legendFormat": "{{method}} {{uri}} {{status}}"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 2,
        "title": "HTTP Response Time (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=\"bandchu-api\"}[5m]))",
            "legendFormat": "{{uri}}"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 3,
        "title": "JVM Heap Memory",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{application=\"bandchu-api\", area=\"heap\"}",
            "legendFormat": "{{id}}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "bytes" }
        },
        "datasource": "Prometheus"
      },
      {
        "id": 4,
        "title": "JVM Thread Count",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "jvm_threads_live_threads{application=\"bandchu-api\"}",
            "legendFormat": "Live Threads"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 5,
        "title": "HTTP Error Rate (5xx)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{application=\"bandchu-api\", status=~\"5..\"}[5m]))",
            "legendFormat": "5xx/sec"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 6,
        "title": "DB Connection Pool",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "hikaricp_connections_active{application=\"bandchu-api\"}",
            "legendFormat": "Active"
          },
          {
            "expr": "hikaricp_connections_idle{application=\"bandchu-api\"}",
            "legendFormat": "Idle"
          },
          {
            "expr": "hikaricp_connections_pending{application=\"bandchu-api\"}",
            "legendFormat": "Pending"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "id": 7,
        "title": "GC Pause Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum{application=\"bandchu-api\"}[1m])",
            "legendFormat": "{{action}} {{cause}}"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "s" }
        },
        "datasource": "Prometheus"
      }
    ],
    "time": { "from": "now-1h", "to": "now" }
  }
}
